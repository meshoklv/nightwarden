# =======================================================================
#  Settings for automatic alert triage.   -> /etc/alert-triage.env
#  chmod 600, owner root.   Do NOT put this file in git.
# =======================================================================

# ------------------------- MASTER SWITCH -------------------------
# 0 -- the service idles and does NOTHING (normal state until you allow it).
# 1 -- triage is active.
TRIAGE_ENABLED=0

# ------------------------- WHERE TO TALK -------------------------
# file     -- NOTHING reaches a human, everything goes to outbox.jsonl (default)
# stdout   -- print to the service journal
# telegram -- real delivery to a Telegram chat
# webhook  -- real delivery: HTTP POST of JSON {"text": ..., "content": ...}
#             (plain text, no HTML) to TRIAGE_WEBHOOK_URL
TRIAGE_SINK=file

# Language of the fixed message templates and of the model's free-text fields:
# en (default) or ru.
TRIAGE_LANG=en

# Webhook target for TRIAGE_SINK=webhook. No default on purpose. The URL is
# usually a secret by itself (Slack/Discord/...): keep this file chmod 600.
# Delivery timeout is 10 s; a failure is logged and never crashes the service.
# TRIAGE_WEBHOOK_URL=https://example.invalid/hook

# The bot token is NOT stored HERE. For TRIAGE_SINK=telegram it is read from
# the guard's own env file, so rotating the bot/token needs no edit: the guard
# and the triage always talk through the same bot. If you create a separate
# bot for triage, change only these three lines.
TRIAGE_TG_ENV_FILE=/etc/malware-watch.env
TRIAGE_TG_TOKEN_VAR=TG_TOKEN
TRIAGE_TG_CHAT_VAR=TG_CHAT

# ------------------------- WHAT TO ANALYSE WITH -------------------------
# Model id passed to `claude --model`. EMPTY = do not pass the flag, i.e. use
# the Claude Code CLI's own default model. Set it only to pin a specific model.
TRIAGE_MODEL=
TRIAGE_EFFORT=medium
TRIAGE_CLAUDE_BIN=/usr/local/bin/claude
TRIAGE_RUN_AS=mwtriage
TRIAGE_RUN_TIMEOUT_S=420

# Claude login. The analysis runs under its own user with a clean home, so the
# usual subscription login is not available to it -- an API key is needed.
# WARNING: uncomment the line below and put the key ONLY in
#    /etc/alert-triage.env (chmod 600). Never in git or in notes.
# ANTHROPIC_API_KEY=

# ------------------------- CEILINGS -------------------------
# Why: the analysis looks at the system, and the guard watches who looks.
# Without ceilings a loop "analysis -> alert -> analysis" and a bill of
# hundreds of dollars are possible.
TRIAGE_MAX_USD_RUN=0.60      # one analysis will not spend more than this (verified)
TRIAGE_MAX_USD_DAY=3.00      # daily spend ceiling
TRIAGE_MAX_PER_HOUR=4        # analyses per hour
TRIAGE_MAX_PER_DAY=12        # analyses per day
TRIAGE_MIN_GAP_S=90          # pause between analyses
TRIAGE_DEDUP_S=21600         # the same alert is not analysed again for 6 hours
TRIAGE_STORM_N=6             # this many alerts within the window = storm
TRIAGE_STORM_WINDOW_S=900    # storm window, seconds
TRIAGE_SELF_QUIET_S=45       # tail of the self-suppression window
PROBE_MAX_CALLS=30           # how many times the analysis may look, per case

# ------------------------- WHERE THINGS LIVE -------------------------
TRIAGE_EVLOG=/var/log/malware-watch/events.jsonl
TRIAGE_BAITLOG=/var/log/bait-watch/events.jsonl
TRIAGE_MUTE_FILE=/var/lib/malware-watch/mute
TRIAGE_STATE=/var/lib/alert-triage
TRIAGE_LOGDIR=/var/log/alert-triage
TRIAGE_HOME=/var/lib/alert-triage/home
TRIAGE_PROMPTS=/usr/local/lib/alert-triage/prompt
TRIAGE_PROBE=/usr/local/lib/alert-triage/probe
TRIAGE_PROBE_SOCK=/run/alert-triage/probe.sock
TRIAGE_SETTINGS=/usr/local/lib/alert-triage/claude-settings.json
TRIAGE_OUTBOX=/var/log/alert-triage/outbox.jsonl
TRIAGE_SENTLOG=/var/log/alert-triage/sent.jsonl
TRIAGE_POLL_S=5
