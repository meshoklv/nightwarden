#!/usr/bin/env python3
# -*- coding: utf-8 -*-
"""
probe -- the only thing the analysing Claude can run.

By itself it can do NOTHING and has no privileges. It just relays the request
to the triage daemon over a local socket and prints the answer. All checking
happens on the other side (probelib.py), as root, from a closed list of verbs.

It is built this way so that the analysis can run as an UNPRIVILEGED user: it
needs neither sudo nor setuid. Even if the analysis is fully hijacked through
alert text, it cannot kill a process, write a file or touch the firewall --
such verbs simply do not exist.

Usage:  probe <verb> [arguments]
        probe help
"""
import json
import os
import socket
import sys

SOCK = os.environ.get("PROBE_SOCK", "/run/alert-triage/probe.sock")
TIMEOUT = 30


def main():
    if len(sys.argv) < 2:
        print("a verb is required. `probe help` shows what I can do")
        return 1
    req = {"verb": sys.argv[1], "args": sys.argv[2:]}
    try:
        s = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
        s.settimeout(TIMEOUT)
        s.connect(SOCK)
        s.sendall((json.dumps(req, ensure_ascii=False) + "\n").encode("utf-8"))
        s.shutdown(socket.SHUT_WR)
        chunks = []
        while True:
            b = s.recv(65536)
            if not b:
                break
            chunks.append(b)
        s.close()
    except socket.timeout:
        print("REFUSED: timed out waiting for the probe service")
        return 2
    except OSError as ex:
        print("REFUSED: cannot reach the probe service (%s)" % type(ex).__name__)
        return 2
    sys.stdout.write(b"".join(chunks).decode("utf-8", "replace"))
    return 0


if __name__ == "__main__":
    sys.exit(main())
