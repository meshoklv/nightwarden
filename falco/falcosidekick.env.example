# Deploy target: /etc/falcosidekick/falcosidekick.env (chmod 640, root:falcosidekick)
# Fill in real values AT DEPLOY TIME only. Never commit the filled-in file.

# --- Telegram (optional) ---
TELEGRAM_TOKEN=__PUT_BOT_TOKEN_HERE__
TELEGRAM_CHATID=__PUT_CHAT_ID_HERE__
# Only events at or above this priority are sent. Rules you want to page on must
# have at least this priority (see falco/10-quiet-dev-noise.yaml).
TELEGRAM_MINIMUMPRIORITY=critical

# --- Generic webhook (optional) ---
# Uncomment to enable. Receives the Falco event JSON.
#WEBHOOK_ADDRESS=https://alerts.example.org/falco
#WEBHOOK_MINIMUMPRIORITY=critical
