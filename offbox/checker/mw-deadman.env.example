# /etc/mw-deadman.env  on each checker host (root:root, 0600)
# Everything the off-box checker needs lives HERE, on the checker host -- it must
# not depend on the watched host for anything (that is the whole point).

# label that appears in every alert (distinct per checker, e.g. checker-a / checker-b)
THIS=checker-a

# --- how THIS host reaches the watched host (see mw-deadman.ssh.example) ---
SSH_ALIAS=watched-host-mw
# SSH_OPTS default already points at /root/.ssh/config; override only if needed.

# --- thresholds ---
HB_STALE=240
HB_FUTURE=30
CLOCK_SKEW=300
SEQ_STALL=300
DEDUP_TTL=1800

# --- alert channels (all optional; if none is set, alarms go to stderr/journal only) ---
# Channel 1: Telegram, sent from THIS host's own internet. Use an alert bot whose
# token is held by this host; never reuse a token that only the watched host holds.
TG_TOKEN=__PUT_BOT_TOKEN_HERE__
TG_CHAT=__PUT_CHAT_ID_HERE__

# Channel 2: generic webhook. POST JSON {"text":"...","content":"..."}
# (works with Slack/Discord/ntfy-style proxies). Leave empty to skip.
#ALERT_WEBHOOK_URL=https://alerts.example.org/hook

# Channel 3: email. Requires a working `sendmail` (e.g. msmtp-mta). Leave empty to skip.
MAIL_TO=alerts@example.org
MAIL_FROM=mw-deadman@checker.example.org
