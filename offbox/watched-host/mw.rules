## Watched host: install as  /etc/audit/rules.d/mw.rules   (root:root, 0640)
## Without auditd, silent root edits to the watcher / persistence surfaces leave no
## record. These rules turn "a quiet root edit" into "an edit + an off-box log line".
##
## Install:  apt-get install -y auditd audispd-plugins
##           cp mw.rules /etc/audit/rules.d/mw.rules
##           augenrules --load          # compiles rules.d -> /etc/audit/audit.rules
##           auditctl -l                # verify loaded;  ausearch -k mwtamper  to read
## Because of "-e 2" below, the rule set LOCKS until reboot: after loading, auditctl -D
## and further rule edits are refused. To change rules later you must reboot.

## reset + robust runtime knobs (kept minimal so the lock at the end is meaningful)
-D
-b 8192
-f 1
--backlog_wait_time 60000

## ---- the watcher's own files & self-defense units (key: mwtamper) ----
-w /usr/local/sbin/malware-watch.sh -p wa -k mwtamper
-w /usr/local/sbin/malware-watch-hb.sh -p wa -k mwtamper
-w /usr/local/sbin/mw-pull-responder -p wa -k mwtamper
-w /etc/malware-watch.env -p wa -k mwtamper
-w /etc/systemd/system/malware-watch.service -p wa -k mwtamper
-w /etc/systemd/system/malware-watch.timer -p wa -k mwtamper
-w /etc/systemd/system/malware-watch-hb.service -p wa -k mwtamper
-w /etc/systemd/system/malware-watch-hb.timer -p wa -k mwtamper
-w /etc/systemd/system/malware-watch.service.d/ -p wa -k mwtamper
-w /var/lib/malware-watch/baseline -p wa -k mwtamper
-w /var/log/malware-watch/events-ledger.jsonl -p wa -k mwtamper
-w /etc/sudoers.d/mw-pull -p wa -k mwtamper
-w /home/mwpull/.ssh/authorized_keys -p wa -k mwtamper
## NOTE: /var/lib/malware-watch/heartbeat and .../seq are intentionally NOT watched —
## they change every minute and would flood the log; their liveness is covered off-box.

## ---- process injection / debugger attach (Mirai/flutter hollowing, ptrace) ----
-a always,exit -F arch=b64 -S ptrace -k mwptrace
-a always,exit -F arch=b32 -S ptrace -k mwptrace

## ---- generic persistence surfaces (key: mwpersist / mwpreload / mwidentity) ----
-w /etc/cron.d/ -p wa -k mwpersist
-w /etc/cron.hourly/ -p wa -k mwpersist
-w /etc/cron.daily/ -p wa -k mwpersist
-w /etc/cron.weekly/ -p wa -k mwpersist
-w /etc/cron.monthly/ -p wa -k mwpersist
-w /etc/crontab -p wa -k mwpersist
-w /var/spool/cron/ -p wa -k mwpersist
-w /etc/systemd/system/ -p wa -k mwpersist
-w /lib/systemd/system/ -p wa -k mwpersist
-w /etc/ld.so.preload -p wa -k mwpreload
-w /etc/passwd -p wa -k mwidentity
-w /etc/shadow -p wa -k mwidentity
-w /etc/sudoers -p wa -k mwidentity
-w /etc/sudoers.d/ -p wa -k mwidentity

## ---- lock the rule set until reboot (root cannot silently auditctl -D) ----
-e 2
