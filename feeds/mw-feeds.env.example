# Install as /etc/mw-feeds.env (chmod 0600, root). Sourced by mw-feeds.sh.

# REQUIRED: your own public egress / VPN endpoint IPs, space-separated.
# Find them with `ip route get 1.1.1.1` and your tunnel's remote address.
# Left empty, a feed that lists your own IP can cut your connectivity.
SELF_IPS="203.0.113.10 198.51.100.7"

# Optional curated IOC networks, space-separated (empty by default).
# Keep in sync with static4 in mw-blocklist.nft and malware-watch IOC_CIDRS.
IOC_CIDRS=""
